    "terminal.ansiBrightCyan": "#9DD9E8",
    "terminal.ansiBrightWhite": "#F0E7D5"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7F97A0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#7DC4D5"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#7DB0E1"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#CBA1C6"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#90D192"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#C3AA48"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other"
      ],
      "settings": {
        "foreground": "#F0E7D5"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#94A9B0"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F9875E",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7DC4D5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#90D192"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#7DC4D5",
        "fontStyle": "underline"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#7DB0E1",
    "method": "#7DB0E1",
    "type": "#CBA1C6",
    "class": "#CBA1C6",
    "interface": "#CBA1C6",
    "enum": "#CBA1C6",
    "keyword": "#7DC4D5",
    "string": "#90D192",
    "number": "#C3AA48",
    "variable": "#F0E7D5",
    "parameter": "#F0E7D5",
    "property": "#F0E7D5",
    "comment": {
      "foreground": "#7F97A0",
      "italic": true
    }
  }
}
