    "editor.findMatchBackground": "#F0A4458C",
    "editor.findMatchHighlightBackground": "#F0A44538",
    "editorWhitespace.foreground": "#3B5159",
    "editorIndentGuide.background1": "#2B4148",
    "editorIndentGuide.activeBackground1": "#3B5159",
    "editorGutter.background": "#13242A",
    "editorError.foreground": "#F9875E",
    "editorWarning.foreground": "#F0A445",
    "editorInfo.foreground": "#7DC4D5",
    "focusBorder": "#7DC4D5",
