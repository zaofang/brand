    "activityBar.border": "#1D333B",
    "statusBar.background": "#1D333B",
    "statusBar.foreground": "#94A9B0",
    "statusBar.border": "#1D333B",
    "statusBarItem.remoteBackground": "#F0A445",
    "statusBarItem.remoteForeground": "#13242A",
