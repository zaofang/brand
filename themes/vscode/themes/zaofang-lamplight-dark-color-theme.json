    "button.background": "#F0A445",
    "button.foreground": "#13242A",
    "button.hoverBackground": "#F0A445",
    "input.background": "#1D333B",
    "input.border": "#3B5159",
    "input.foreground": "#F0E7D5",
    "input.placeholderForeground": "#94A9B0",
    "dropdown.background": "#1D333B",
    "dropdown.border": "#3B5159",
    "badge.background": "#2B4148",
