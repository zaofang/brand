    "list.activeSelectionForeground": "#F0E7D5",
    "list.hoverBackground": "#1D333B",
    "list.inactiveSelectionBackground": "#1D333B",
    "list.highlightForeground": "#7DC4D5",
    "gitDecoration.addedResourceForeground": "#90D192",
    "gitDecoration.modifiedResourceForeground": "#7DB0E1",
    "gitDecoration.deletedResourceForeground": "#F9875E",
    "gitDecoration.untrackedResourceForeground": "#90D192",
    "editorWidget.background": "#1D333B",
    "editorWidget.border": "#3B5159",
    "scrollbarSlider.background": "#3B515980",
    "terminal.ansiBlack": "#1D333B",
    "terminal.ansiRed": "#F9875E",
    "terminal.ansiGreen": "#90D192",
    "terminal.ansiYellow": "#F0A445",
    "terminal.ansiBlue": "#7DB0E1",
    "terminal.ansiMagenta": "#CBA1C6",
    "terminal.ansiCyan": "#7DC4D5",
    "terminal.ansiWhite": "#C9C1B0",
    "terminal.ansiBrightBlack": "#50707A",
    "terminal.ansiBrightRed": "#FFA481",
